<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_voucher_fetch_wizard_form" model="ir.ui.view">
            <field name="name">voucher.fetch.wizard.form</field>
            <field name="model">voucher.fetch.wizard</field>
            <field name="arch" type="xml">
                <form string="Fetch &amp; Create JV">
                    <sheet>
                        <group>
                            <label for="date_from" string="Dates"/>
                            <div class="o_row" style="max-width: 300px;">
                                <field name="date_from" widget="daterange"
                                       options="{'end_date_field': 'date_to'}"/>
                                <field name="date_to" invisible="1"/>
                            </div>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Fetch &amp; Create JV" type="object" name="action_fetch_and_create_jv"
                                class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_voucher_fetch_wizard" model="ir.actions.act_window">
            <field name="name">Fetch &amp; Create JV</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">voucher.fetch.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_api_fetch_root"
                  name="API"
                  parent="accountant.menu_accounting"
                  sequence="30"/>

        <menuitem id="menu_fetch_voucher_jv"
                  name="Fetch JV"
                  parent="menu_api_fetch_root"
                  action="action_voucher_fetch_wizard"
                  sequence="10"/>
    </data>
</odoo>