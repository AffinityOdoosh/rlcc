<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_api_fetch_log_tree" model="ir.ui.view">
            <field name="name">api.fetch.log.list</field>
            <field name="model">api.fetch.log</field>
            <field name="arch" type="xml">
                <list string="API Fetch Logs" create="false" edit="0" delete="0">
                    <field name="execution_time"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="status" widget="badge" decoration-success="status == 'success'"
                           decoration-danger="status == 'failed'" decoration-warning="status == 'warning'"/>
                    <field name="total_retrieved"/>
                    <field name="total_created"/>
                    <field name="total_skipped"/>
                </list>
            </field>
        </record>

        <record id="view_api_fetch_log_form" model="ir.ui.view">
            <field name="name">api.fetch.log.form</field>
            <field name="model">api.fetch.log</field>
            <field name="arch" type="xml">
                <form string="API Fetch Log Detail" create="0" edit="0" delete="0">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="execution_time" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Execution Context">
                                <field name="status" widget="badge" decoration-success="status == 'success'"
                                       decoration-danger="status == 'failed'" decoration-warning="status == 'warning'"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                            <group string="Summary Metrics">
                                <field name="total_retrieved"/>
                                <field name="total_created"/>
                                <field name="total_skipped"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Created Journal Entries" name="moves">
                                <field name="move_ids" readonly="1">
                                    <list string="Fetched Journal Entries" create="0" delete="0">
                                        <field name="name" string="Number"/>
                                        <field name="ref" string="Reference / Voucher"/>
                                        <field name="date"/>
                                        <field name="journal_id"/>
                                        <field name="amount_total_signed" string="Total Amount" sum="Total"/>
                                        <field name="state" widget="badge" decoration-info="state == 'draft'"
                                               decoration-success="state == 'posted'"/>
                                    </list>
                                    <form string="Journal Entry Preview" create="0" edit="0" delete="0">
                                        <sheet>
                                            <div class="oe_title" invisible="not name">
                                                <h1>
                                                    <field name="name" no_label="1" readonly="1"/>
                                                </h1>
                                            </div>
                                            <group>
                                                <group>
                                                    <field name="ref" string="External Voucher Ref"/>
                                                    <field name="date"/>
                                                </group>
                                                <group>
                                                    <field name="journal_id"/>
                                                    <field name="company_id" groups="base.group_multi_company"/>
                                                </group>
                                            </group>
                                            <notebook>
                                                <page string="Journal Items" name="lines">
                                                    <field name="line_ids" readonly="1">
                                                        <list string="Journal Items" create="0" edit="0" delete="0">
                                                            <field name="account_id"/>
                                                            <field name="name" string="Label / Description"/>
                                                            <field name="debit" sum="Total Debit"/>
                                                            <field name="credit" sum="Total Credit"/>
                                                        </list>
                                                    </field>
                                                </page>
                                            </notebook>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page string="Errors &amp; Unmapped Accounts" name="errors"
                                  invisible="not error_message and not unmapped_accounts_log">
                                <group>
                                    <field name="error_message" invisible="not error_message"/>
                                    <field name="unmapped_accounts_log" invisible="not unmapped_accounts_log"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_api_fetch_log" model="ir.actions.act_window">
            <field name="name">API Fetch Logs</field>
            <field name="res_model">api.fetch.log</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_api_fetch_log"
                  name="API Sync Logs"
                  action="action_api_fetch_log"
                  parent="menu_api_fetch_root"
                  groups="group_api_manager"
                  sequence="100"/>
    </data>
</odoo>