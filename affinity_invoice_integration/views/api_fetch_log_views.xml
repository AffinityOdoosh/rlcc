<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_api_fetch_log_tree" model="ir.ui.view">
            <field name="name">api.fetch.log.list</field>
            <field name="model">api.fetch.log</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="name"/>
                    <field name="execution_time"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="status" widget="badge" decoration-success="status == 'success'"
                           decoration-danger="status == 'failed'" decoration-warning="status == 'warning'"/>
                </list>
            </field>
        </record>

        <record id="view_api_fetch_log_form" model="ir.ui.view">
            <field name="name">api.fetch.log.form</field>
            <field name="model">api.fetch.log</field>
            <field name="arch" type="xml">
                <form string="API Fetch Log Detail" create="0" edit="0" delete="0">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Execution Context">
                                <field name="status" widget="badge" decoration-success="status == 'success'"
                                       decoration-danger="status == 'failed'" decoration-warning="status == 'warning'"/>
                                <field name="execution_time"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                            <group string="Summary Metrics">
                                <field name="total_retrieved"/>
                                <field name="total_created"/>
                                <field name="total_skipped"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Created Journal Entries" name="moves" invisible="not move_ids">
                                <field name="move_ids" readonly="1">
                                    <list string="Fetched Journal Entries" create="0" delete="0">
                                        <field name="name" string="Number"/>
                                        <field name="ref" string="Reference / Voucher"/>
                                        <field name="date"/>
                                        <field name="journal_id"/>
                                        <field name="amount_total_signed" string="Total Amount" sum="Total"/>
                                        <field name="state" widget="badge" decoration-info="state == 'draft'"
                                               decoration-success="state == 'posted'"/>
                                    </list>
                                    <form string="Journal Entry Preview" create="0" edit="0" delete="0">
                                        <sheet>
                                            <div class="oe_title" invisible="not name">
                                                <h1>
                                                    <field name="name" no_label="1" readonly="1"/>
                                                </h1>
                                            </div>
                                            <group>
                                                <group>
                                                    <field name="ref" string="External Voucher Ref"/>
                                                    <field name="date"/>
                                                </group>
                                                <group>
                                                    <field name="journal_id"/>
                                                    <field name="company_id" groups="base.group_multi_company"/>
                                                </group>
                                            </group>
                                            <notebook>
                                                <page string="Journal Items" name="lines">
                                                    <field name="line_ids" readonly="1">
                                                        <list string="Journal Items" create="0" edit="0" delete="0">
                                                            <field name="account_id"/>
                                                            <field name="name" string="Label / Description"/>
                                                            <field name="debit" sum="Total Debit"/>
                                                            <field name="credit" sum="Total Credit"/>
                                                        </list>
                                                    </field>
                                                </page>
                                            </notebook>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page string="Deletion History" name="deletion_log" invisible="not deletion_log">
                                <div class="o_horizontal_separator text_uppercase fw-bolder text-muted mb-3">
                                    Deletion Trace &amp; Audit Logs
                                </div>
                                <div class="alert alert-danger d-flex align-items-start mb-3" role="alert">
                                    <i class="fa fa-exclamation-triangle fa-2x me-3 flex-shrink-0 text-danger mt-1"
                                       title="Log Alert"/>
                                    <div class="w-100">
                                        <h5 class="alert-heading font-weight-bold mb-1">
                                            Audit Record Found
                                        </h5>
                                        <p class="mb-0 text-muted small">
                                            Review the recorded system trace and unmapped/deleted entity history details
                                            below.
                                        </p>
                                    </div>
                                </div>
                                <div class="w-100">
                                    <field name="deletion_log" widget="html" nolabel="1" readonly="1"
                                           options="{'cssEdit': false}"/>
                                </div>
                            </page>
                            <page string="Errors &amp; Unmapped Accounts" name="errors"
                                  invisible="not error_message and not unmapped_accounts_log">
                                <div class="o_horizontal_separator text_uppercase fw-bolder text-muted mb-3">
                                    System Exceptions &amp; Diagnostics
                                </div>
                                <div class="w-100 mb-4" invisible="not error_message">
                                    <div class="alert alert-danger d-flex align-items-start mb-3" role="alert"
                                         style="border-left: 4px solid #dc3545;">
                                        <i class="fa fa-exclamation-triangle fa-2x me-3 flex-shrink-0 text-danger mt-1"
                                           title="Error Alert"/>
                                        <div class="w-100">
                                            <h5 class="alert-heading font-weight-bold mb-1">
                                                Execution Error Encountered
                                            </h5>
                                            <field name="error_message" widget="html" nolabel="1" readonly="1"
                                                   options="{'cssEdit': false}"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="w-100" invisible="not unmapped_accounts_log">
                                    <div class="alert alert-warning d-flex align-items-start mb-3" role="alert"
                                         style="border-left: 4px solid #ffc107;">
                                        <i class="fa fa-exclamation-circle fa-2x me-3 flex-shrink-0 text-warning mt-1"
                                           title="Mapping Alert"/>
                                        <div class="w-100">
                                            <h5 class="alert-heading font-weight-bold mb-1">
                                                Unmapped External Accounts Found
                                            </h5>
                                            <p class="mb-2 text-muted small">
                                                Review the missing accounts below and map them in your Chart of Accounts
                                                to proceed.
                                            </p>
                                            <field name="unmapped_accounts_log" widget="html" nolabel="1" readonly="1"
                                                   options="{'cssEdit': false}"/>
                                        </div>
                                    </div>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_api_fetch_log" model="ir.actions.act_window">
            <field name="name">Sync Logs</field>
            <field name="res_model">api.fetch.log</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_api_fetch_log"
                  name="Sync Logs"
                  action="action_api_fetch_log"
                  parent="menu_api_fetch_root"
                  groups="group_api_manager"
                  sequence="100"/>
    </data>
</odoo>