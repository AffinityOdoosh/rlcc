<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_move_form_inherit_api_fetched" model="ir.ui.view">
            <field name="name">account.move.form.inherit.api.fetched</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='ref']" position="after">
                    <field name="is_api_fetched" invisible="1"/>
                </xpath>
            </field>
        </record>

        <record id="view_account_move_filter_inherit_api_fetched" model="ir.ui.view">
            <field name="name">account.move.select.inherit.api.fetched</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_move_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="is_api_fetched"/>
                </xpath>
                <xpath expr="//filter[@name='posted']" position="after">
                    <filter string="Fetched via API" name="is_api_fetched" domain="[('is_api_fetched', '=', True)]"/>
                </xpath>
                <xpath expr="//group" position="inside">
                    <filter string="Fetched via API" name="group_is_api_fetched" domain="[]"
                            context="{'group_by': 'is_api_fetched'}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>