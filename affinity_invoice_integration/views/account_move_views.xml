<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_move_form_inherit_voucher_sync" model="ir.ui.view">
            <field name="name">account.move.form.inherit.voucher.sync</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form[1]/sheet[1]/group[1]/group[2]/field[@name='date']" position="after">
                    <label for="voucher_date_from" string="Voucher Date"
                           invisible="move_type != 'entry' or not voucher_date_from"/>
                    <div class="o_row" style="max-width: 300px;"
                         invisible="move_type != 'entry' or not voucher_date_from">
                        <field name="voucher_date_from" widget="daterange"
                               options="{'end_date_field': 'voucher_date_to'}" readonly="1"/>
                        <field name="voucher_date_to" invisible="1" readonly="1"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>