<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <data>
        <record id="view_expense_module_filter" model="ir.ui.view">
            <field name="name">record.expense.tier.validation</field>
            <field name="model">record.expense</field>
            <field name="inherit_id" ref="affinity_record_expense.view_expense_module_search"/>
            <field name="arch" type="xml">
                <search position="inside">
                    <group expand="0" string="Need actions">
                        <filter name="needs_review" string="Needs Review"
                                domain="[('reviewer_ids','in',uid), ('state', 'not in', ['done', 'cancel'])]"
                                help="My Purchases to review"/>
                        <filter name="tier_validated" string="Validated" domain="[('validated', '=', True)]"
                                help="Purchase Requests validated and ready to be confirmed"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>