<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="group_sql_console_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_sql_console"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sql_console_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_sql_console"/>
            <field name="implied_ids" eval="[(4, ref('group_sql_console_user'))]"/>
        </record>

        <record id="group_sql_console" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_sql_console"/>
            <field name="implied_ids" eval="[(4, ref('group_sql_console_manager'))]"/>
        </record>
    </data>
</odoo>