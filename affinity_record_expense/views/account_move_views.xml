<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="jv_inherited" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" icon="fa-money" type="object" name="action_open_expense"
                            invisible="not expense_id" string="Expense">
                        <field name="expense_id" invisible="1"/>
                    </button>
                </xpath>
                <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/field[@name='ref'][2]" position="after">
                    <field name="cheque_number"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>