<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="affinity_approval_framework.Collapse">
        <div class="o_form_sheet panel-group modern-review-container">
            <div class="panel panel-default modern-review-card">
                <div class="panel-heading modern-review-header" t-on-click="onToggleCollapse"
                     t-att-class="{'collapsed': state.collapse}">
                    <h4 class="panel-title m-0 d-flex justify-content-between align-items-center">
                        <a class="o_info_btn fw-bold text-decoration-none" href="#">
                            <i class="fa fa-check-square-o me-2 text-primary"/>Reviews
                        </a>
                        <i class="fa fa-chevron-up modern-chevron"/>
                    </h4>
                </div>

                <div class="modern-review-content-wrapper" t-att-class="{'collapsed': state.collapse}">
                    <div class="modern-review-content">
                        <div class="panel-body o_review">
                            <table class="table table-borderless table-hover mb-0 modern-review-table">
                                <thead>
                                    <tr>
                                        <th name="th_sequence" class="text-center">Sequence</th>
                                        <th name="th_requested_by" class="text-start">Requested by</th>
                                        <th name="th_name" class="text-end">Description</th>
                                        <th name="th_display_status" class="text-end">Status</th>
                                        <th name="th_todo_by" class="text-end">Todo by</th>
                                        <th name="th_done_by" class="text-end">Done by</th>
                                        <th name="th_reviewed_date" class="text-end">Validation Date</th>
                                        <th name="th_comment" class="text-start">Comment</th>
                                    </tr>
                                </thead>
                                <tbody class="sale_tbody">
                                    <t t-foreach="_getReviewData()" t-as="review" t-key="review.id">
                                        <t t-if="review.status == 'waiting'" t-set="status_class"
                                           t-value="'text-muted bg-light'"/>
                                        <t t-if="review.status == 'pending'" t-set="status_class" t-value="'bg-white'"/>
                                        <t t-if="review.status == 'approved'" t-set="status_class"
                                           t-value="'table-success text-success'"/>
                                        <t t-if="review.status == 'rejected'" t-set="status_class"
                                           t-value="'table-danger text-danger'"/>

                                        <tr t-att-class="status_class" class="align-middle">
                                            <td name="td_sequence" class="text-center fw-bold">
                                                <span t-out="review.sequence"/>
                                            </td>
                                            <td name="td_requested_by" class="text-start">
                                                <span t-out="review.requested_by[1]"/>
                                            </td>
                                            <td name="td_name" class="text-end">
                                                <span t-out="review.name"/>
                                            </td>
                                            <td name="td_display_status" class="text-end fw-semibold">
                                                <span t-out="review.display_status"/>
                                            </td>
                                            <td name="td_todo_by" class="text-end">
                                                <span t-out="review.todo_by"/>
                                            </td>
                                            <td name="td_done_by" class="text-end">
                                                <span t-out="review.done_by[1]"/>
                                            </td>
                                            <td name="td_reviewed_date" class="text-end">
                                                <t t-if="review.reviewed_formated_date">
                                                    <span t-out="review.reviewed_formated_date"/>
                                                </t>
                                            </td>
                                            <td name="td_comment" class="text-start">
                                                <t t-if="review.comment">
                                                    <span t-out="review.comment"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>