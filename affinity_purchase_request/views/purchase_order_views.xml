<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <data>
        <record id="purchase_order_form" model="ir.ui.view">
            <field name="name">purchase.order.form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/list" position="inside">
                    <field name="purchase_request_lines" column_invisible="1"/>
                    <button
                            invisible="not purchase_request_lines"
                            name="action_open_request_line_tree_view"
                            title="Request Lines"
                            type="object"
                            icon="fa-folder-open-o"
                    />
                </xpath>
                <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/field[@name='currency_id']" position="after">
                    <field name="purchase_request_id" readonly="1" invisible="not purchase_request_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>