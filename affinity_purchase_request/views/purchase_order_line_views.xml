<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="purchase_order_line_form2" model="ir.ui.view">
            <field name="name">purchase.order.line.form2.inherit</field>
            <field name="model">purchase.order.line</field>
            <field name="inherit_id" ref="purchase.purchase_order_line_form2"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <separator string="Purchase Request Lines"/>
                    <field name="purchase_request_lines" widget="many2many_tags"/>
                </field>
            </field>
        </record>

        <record id="purchase_order_line_tree" model="ir.ui.view">
            <field name="name">purchase.order.line.list.inherit</field>
            <field name="model">purchase.order.line</field>
            <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="purchase_request_lines" column_invisible="1"/>
                    <button name="action_open_request_line_tree_view" type="object" string="Request Lines"
                            icon="fa-folder-open-o" class="btn-link text-primary p-0"
                            invisible="not purchase_request_lines"/>
                </xpath>
            </field>
        </record>

        <record id="purchase_order_line_form2_sub" model="ir.ui.view">
            <field name="name">purchase.order.line.form2.sub</field>
            <field name="model">purchase.order.line</field>
            <field name="arch" type="xml">
                <form string="Purchase Order Line" create="false" edit="false">
                    <sheet>
                        <div class="oe_title">
                            <label for="order_id" class="text-muted fw-bold"/>
                            <h1 class="d-flex align-items-center gap-2">
                                <field name="order_id" class="text-primary"/>
                                <span invisible="not date_order" class="text-muted">-</span>
                                <field name="date_order"/>
                            </h1>
                            <div class="mt-1">
                                <span class="me-2 text-muted">Vendor:</span>
                                <field name="partner_id" class="fw-bold"/>
                            </div>
                        </div>
                        <group>
                            <group string="Product Details">
                                <field name="product_id"/>
                                <label for="product_qty"/>
                                <div class="o_row">
                                    <field name="product_qty" class="oe_inline fw-bold"/>
                                    <field name="product_uom" groups="uom.group_uom" class="oe_inline"/>
                                    <field name="product_uom_category_id" invisible="1"/>
                                </div>
                                <field name="price_unit" widget="monetary"/>
                            </group>
                            <group string="Order Configuration">
                                <field name="taxes_id" widget="many2many_tags"
                                       domain="[('type_tax_use', '=', 'purchase')]"/>
                                <field name="date_planned" widget="date"/>
                                <field name="company_id" groups="base.group_multi_company"
                                       options="{'no_create': True}"/>
                                <field name="analytic_distribution" widget="analytic_distribution"
                                       groups="analytic.group_analytic_accounting"
                                       options="{'product_field': 'product_id', 'business_domain': 'purchase_order'}"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="name" nolabel="1" placeholder="Add detailed line description..."/>
                        </group>
                        <notebook>
                            <page string="Purchase Requests" name="purchase_requests">
                                <field name="purchase_request_lines" readonly="1"/>
                            </page>
                            <page string="Stock Moves" name="stock_moves">
                                <field name="move_ids" readonly="1"/>
                            </page>
                            <page string="Invoices" name="invoices">
                                <field name="invoice_lines" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="purchase_order_line_tree_sub" model="ir.ui.view">
            <field name="name">purchase.order.line.list.sub</field>
            <field name="model">purchase.order.line</field>
            <field name="arch" type="xml">
                <list string="Purchase Order Lines" create="false">
                    <field name="order_id" widget="many2one"/>
                    <field name="partner_id" string="Vendor"/>
                    <field name="product_id"/>
                    <field name="name" optional="show"/>
                    <field name="product_qty" sum="Total Qty"/>
                    <field name="product_uom" groups="uom.group_uom" optional="show"/>
                    <field name="price_unit" widget="monetary"/>
                    <field name="price_subtotal" widget="monetary" sum="Total Subtotal"/>
                    <field name="date_planned" widget="date" optional="show"/>
                    <field name="purchase_request_lines" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="purchase_order_line_search_sub" model="ir.ui.view">
            <field name="name">purchase.order.line.search.sub</field>
            <field name="model">purchase.order.line</field>
            <field name="arch" type="xml">
                <search string="Search Purchase Order Line">
                    <field name="order_id"/>
                    <field name="product_id"/>
                    <field name="partner_id" string="Vendor" filter_domain="[('partner_id', 'child_of', self)]"/>
                    <filter string="Active Lines" name="hide_cancelled" domain="[('state', '!=', 'cancel')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter name="order_reference" string="Order Reference" context="{'group_by': 'order_id'}"/>
                        <filter name="groupby_supplier" string="Vendor" context="{'group_by': 'partner_id'}"/>
                        <filter name="groupby_product" string="Product" context="{'group_by': 'product_id'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>