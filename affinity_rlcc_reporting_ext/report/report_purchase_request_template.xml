<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_purchase_request_rlcc_template">
            <t t-set="primary_color" t-value="'#5E1756'"/>
            <div class="page" style="font-size: 14px;">
                <!-- Header Title -->
                <!-- Header Title -->
                <div t-attf-style="border-bottom:3px solid {{primary_color}}; padding-bottom:10px; margin-bottom:20px;">
                    <h2 class="text-center fw-bold text-uppercase mb-0"
                        t-attf-style="color:{{primary_color}}; letter-spacing:2px;">
                        RLCC Purchase Request
                    </h2>
                </div>

                <!-- Info Box -->
                <div style="background:#F5F7FA; border:1px solid #D9E2EC; border-radius:8px; padding:18px 22px; margin-bottom:25px;">
                    <div class="row align-items-center">
                        <div class="col-4">
                            <div style="font-size:11px; color:#6B7280; text-transform:uppercase; font-weight:600; letter-spacing:.5px;">
                                Requisition #
                            </div>
                            <div style="font-size:15px; font-weight:600; color:#1F2937; margin-top:4px;">
                                <span t-field="o.name"/>
                            </div>
                        </div>
                        <div class="col-4 text-center">
                            <div style="font-size:11px; color:#6B7280; text-transform:uppercase; font-weight:600; letter-spacing:.5px;">
                                Date Received On
                            </div>
                            <div style="font-size:15px; font-weight:600; color:#1F2937; margin-top:4px;">
                                <span t-field="o.date"/>
                            </div>
                        </div>
                        <div class="col-4 text-end">
                            <div style="font-size:11px; color:#6B7280; text-transform:uppercase; font-weight:600; letter-spacing:.5px;">
                                Department
                            </div>
                            <div style="font-size:15px; font-weight:600; color:#1F2937; margin-top:4px;"/>
                        </div>
                    </div>
                </div>

                <!-- Main Items Table -->
                <table class="table mb-4"
                       style="font-size:14px; border:1px solid #d7dee8; border-collapse:separate; border-spacing:0; overflow:hidden; border-radius:8px;">
                    <thead t-attf-style="background:{{primary_color}};">
                        <tr>
                            <th class="text-center py-3 ps-3 text-uppercase"
                                style="width: 50px; border:none; border-right:1px solid rgba(255,255,255,0.15); font-weight:600; letter-spacing:.5px; color:#FFFFFF;">
                                S.#
                            </th>
                            <th class="text-start py-3 ps-3 text-uppercase"
                                style="border:none; border-right:1px solid rgba(255,255,255,0.15); font-weight:600; letter-spacing:.5px; color:#FFFFFF;">
                                Item
                            </th>
                            <th class="text-center py-3 text-uppercase"
                                style="border:none; border-right:1px solid rgba(255,255,255,0.15); font-weight:600; letter-spacing:.5px; color:#FFFFFF;">
                                Unit
                            </th>
                            <th class="text-center py-3 text-uppercase"
                                style="border:none; border-right:1px solid rgba(255,255,255,0.15); font-weight:600; letter-spacing:.5px; color:#FFFFFF;">
                                Qty Required
                            </th>
                            <th class="text-start py-3 text-uppercase"
                                style="border:none; border-right:1px solid rgba(255,255,255,0.15); font-weight:600; letter-spacing:.5px; color:#FFFFFF;">
                                Remarks / Purpose
                            </th>
                            <th class="text-start py-3 pe-3 text-uppercase"
                                style="border:none; border-right:1px solid #d7dee8; font-weight:600; letter-spacing:.5px; color:#FFFFFF;">
                                Vendor Name / Number / Status
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="serial_no" t-value="1"/>
                        <tr t-foreach="o.line_ids" t-as="line"
                            style="border-bottom:1px solid #d7dee8; background:#ffffff;">
                            <td class="py-3 ps-3 text-center" style="border-right:1px solid #d7dee8; color:#495057;">
                                <span t-esc="serial_no"/>
                                <t t-set="serial_no" t-value="serial_no + 1"/>
                            </td>
                            <td class="py-3 ps-3" style="border-right:1px solid #d7dee8;">
                                <div class="fw-bold" t-attf-style="color:{{primary_color}};"
                                     t-field="line.product_id.name"/>
                                <div class="mt-1" style="color:#6c7a89;" t-field="line.name"/>
                            </td>
                            <td class="py-3 text-center" style="color:#1f2937; border-right:1px solid #d7dee8;">
                                <span t-field="line.product_uom_id.name" groups="uom.group_uom"/>
                            </td>
                            <td class="py-3 text-center" style="color:#1f2937; border-right:1px solid #d7dee8;">
                                <span t-field="line.product_qty"/>
                            </td>
                            <td class="py-3 ps-3" style="color:#495057; border-right:1px solid #d7dee8;"/>
                            <td class="py-3 pe-3" style="color:#495057; border-right:1px solid #d7dee8;"/>
                        </tr>
                    </tbody>
                </table>

                <!-- Signature Section -->
                <div style="margin-top:45px; font-size:13px; color:#1F2937;">

                    <div style="padding:12px 0;">
                        <span style="display:inline-block; width:180px; font-weight:600;">Prepared by Admin</span>
                        <span style="display:inline-block; width:220px; border-bottom:1px solid #9CA3AF; height:14px; vertical-align:bottom;"/>
                        <span style="display:inline-block; width:80px; color:#6B7280; font-size:12px;">(3 days)</span>
                        <span style="color:#6B7280; font-size:12px;">Date:</span>
                    </div>

                    <div style="padding:12px 0;">
                        <span style="display:inline-block; width:180px; font-weight:600;">Approved by HOD</span>
                        <span style="display:inline-block; width:220px; border-bottom:1px solid #9CA3AF; height:14px; vertical-align:bottom;"/>
                        <span style="display:inline-block; width:80px; color:#6B7280; font-size:12px;">(1 day)</span>
                        <span style="color:#6B7280; font-size:12px;">Date:</span>
                    </div>

                    <div style="padding:12px 0;">
                        <span style="display:inline-block; width:180px; font-weight:600;">Verified by Accounts</span>
                        <span style="display:inline-block; width:220px; border-bottom:1px solid #9CA3AF; height:14px; vertical-align:bottom;"/>
                        <span style="display:inline-block; width:80px; color:#6B7280; font-size:12px;">(2 days)</span>
                        <span style="color:#6B7280; font-size:12px;">Date:</span>
                    </div>

                    <div style="padding:12px 0;">
                        <span style="display:inline-block; width:180px; font-weight:600;">Approved by Management</span>
                        <span style="display:inline-block; width:220px; border-bottom:1px solid #9CA3AF; height:14px; vertical-align:bottom;"/>
                        <span style="display:inline-block; width:80px; color:#6B7280; font-size:12px;">(2 days)</span>
                        <span style="color:#6B7280; font-size:12px;">Date:</span>
                    </div>

                    <div style="padding:12px 0;">
                        <span style="display:inline-block; width:180px; font-weight:600;">Cash received by Admin</span>
                        <span style="display:inline-block; width:220px; border-bottom:1px solid #9CA3AF; height:14px; vertical-align:bottom;"/>
                        <span style="display:inline-block; width:80px; color:#6B7280; font-size:12px;">(2 days)</span>
                        <span style="color:#6B7280; font-size:12px;">Date:</span>
                    </div>

                    <div style="padding:12px 0;">
                        <span style="display:inline-block; width:180px; font-weight:600;">Purchased by</span>
                        <span style="display:inline-block; width:220px; border-bottom:1px solid #9CA3AF; height:14px; vertical-align:bottom;"/>
                        <span style="display:inline-block; width:80px; color:#6B7280; font-size:12px;">(2 days)</span>
                        <span style="color:#6B7280; font-size:12px;">Date:</span>
                    </div>

                    <div style="padding:12px 0;">
                        <span style="display:inline-block; width:180px; font-weight:600;">Received by HOD</span>
                        <span style="display:inline-block; width:220px; border-bottom:1px solid #9CA3AF; height:14px; vertical-align:bottom;"/>
                        <span style="display:inline-block; width:80px; color:#6B7280; font-size:12px;">(1 day)</span>
                        <span style="color:#6B7280; font-size:12px;">Date:</span>
                    </div>

                </div>
            </div>
        </template>

        <template id="report_purchase_request_temp">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="pager" t-value="False"/>
                    <t t-call="web.external_layout">
                        <t t-call="affinity_rlcc_reporting_ext.report_purchase_request_rlcc_template"/>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>